diff --git a/arch/arm64/configs/vendor/kona-perf_defconfig b/arch/arm64/configs/vendor/kona-perf_defconfig
index 5b64d899..833f0aff 100755
--- a/arch/arm64/configs/vendor/kona-perf_defconfig
+++ b/arch/arm64/configs/vendor/kona-perf_defconfig
@@ -1,3 +1,39 @@
+# Devicetree overlay (fixes 19821/Makefile's CONFIG_ARCH_LITO typo in its non-overlay
+# branch — with this on, the correct dtbo-$(CONFIG_ARCH_KONA) branch is used instead,
+# matching luk1337 and LineageOS's own kona-perf_defconfig)
+CONFIG_BUILD_ARM64_DT_OVERLAY=y
+# Oplus Phoenix write-back kernel log (config only; not wired into a build
+# rule yet — parked until we have a successful boot to build on)
+CONFIG_WB_KERNEL_LOG=y
+# ReSukiSU + SUSFS (OOS 4.19.157)
+CONFIG_KSU=y
+CONFIG_KSU_SUSFS=y
+CONFIG_KSU_SUSFS_SUS_PATH=y
+CONFIG_KSU_SUSFS_SUS_MOUNT=y
+CONFIG_KSU_SUSFS_SUS_KSTAT=y
+CONFIG_KSU_SUSFS_SPOOF_UNAME=y
+CONFIG_KSU_SUSFS_ENABLE_LOG=y
+CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
+CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
+CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
+CONFIG_KSU_SUSFS_SUS_MAP=y
+# Baseband-guard
+CONFIG_BBG=y
+# DroidSpaces
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_IPC_NS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_NET_PRIO=y
+CONFIG_DEVTMPFS=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NF_TABLES=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_USER_NS=y
+# WLAN: 用 modules_and_devicetree 里的 qcacld-3.0 做内核内构建
+# (drivers/staging/qcacld-3.0 + ../qca-wifi-host-cmn + ../fw-api, glue 见 build-ready)
+CONFIG_QCA_CLD_WLAN=m
 CONFIG_LOCALVERSION="-perf"
 # CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_NO_HZ=y
