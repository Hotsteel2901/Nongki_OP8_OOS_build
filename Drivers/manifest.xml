<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drivers/manifest.xml

  ONE mapping file for the out-of-tree Qualcomm driver sources that the OnePlus 8
  (sm8250 / kona) OOS kernel needs but does not carry in its own git tree.

  .github/workflows/build-ready/action.yml runs `Drivers/apply.py` with this file
  before the kernel is compiled; the applier creates every link/copy and the kbuild
  glue lines listed below.

  Origins (where the sources come from):
    oplus        $GITHUB_WORKSPACE/vendor (= vendor/ of
                 OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8250, env
                 VENDOR_SOURCE/VENDOR_BRANCH). This is the same repository the OnePlus
                 OOS manifest maps with <linkfile> entries, so the paths below mirror it.
    oplus-clone  the still checked out clone of that repository (kernel/msm-4.19/techpack/*,
                 which is an EMPTY gitlink in the kernel repo and has to be filled).
    luk          fallback: luk1337/android_kernel_oneplus_sm8250 (LineageOS 19.1).
                 luk vendors the very same Qualcomm sources in-tree (identical blobs to
                 vendor/), e.g. drivers/staging/qcacld-3.0 and techpack/audio + techpack/data,
                 so he is a drop-in second source if OnePlusOSS ever drops a directory.
                 Cloned lazily, only if a primary source of an enabled entry is missing.

  entry attributes:
    name     label used in the log
    dst      destination relative to the kernel tree (default kernel/msm-4.19)
    mode     symlink = link the source tree (drivers/staging/Makefile lists it explicitly)
             copy    = copy the source tree (needed for techpack/: techpack/Kbuild discovers
                       its subdirectories with `find -type d`, which does not follow symlinks)
    enabled  true  = wired into the build
             false = declared here for documentation only, deliberately NOT wired in yet
    config   which switch actually compiles the driver (informational)
    note     explanation, printed by the applier

  child elements:
    <source>   one candidate origin + path; tried in order, first hit wins
    <glue>     line that has to be added to an existing kernel file for kbuild to enter the
               driver (appended at EOF, or before the line given by `before`); \t and \n
               escapes are understood, and the operation is skipped if the line already exists
    <overlay>  glue files that live in this repository, copied on top of the applied source
-->
<drivers-manifest version="1">

  <origins>
    <origin id="oplus"       kind="local" root="vendor"/>
    <origin id="oplus-clone" kind="local" root="oos_vendor_tmp"/>

    <origin id="luk" kind="git"
            repo="https://github.com/luk1337/android_kernel_oneplus_sm8250.git"
            branch="lineage-19.1"
            sparse="drivers/staging/fw-api drivers/staging/qca-wifi-host-cmn drivers/staging/qcacld-3.0 techpack/audio techpack/data techpack/camera techpack/display techpack/video"/>
  </origins>

  <map>

    <!-- ================= techpack: empty gitlinks in the OOS kernel repo ================= -->
    <entry name="techpack/camera" dst="techpack/camera" mode="copy" enabled="true"
           config="built unconditionally, techpack/Kbuild auto-finds every techpack subdir"
           note="empty gitlink in OnePlus OOS kernel; OnePlus HAL needs the OOS camera driver, so luk is only a last resort">
      <source origin="oplus-clone" path="kernel/msm-4.19/techpack/camera"/>
      <source origin="luk"         path="techpack/camera"/>
    </entry>

    <entry name="techpack/display" dst="techpack/display" mode="copy" enabled="true"
           config="built unconditionally, techpack/Kbuild auto-finds every techpack subdir"
           note="empty gitlink in OnePlus OOS kernel">
      <source origin="oplus-clone" path="kernel/msm-4.19/techpack/display"/>
      <source origin="luk"         path="techpack/display"/>
    </entry>

    <entry name="techpack/video" dst="techpack/video" mode="copy" enabled="true"
           config="built unconditionally, techpack/Kbuild auto-finds every techpack subdir"
           note="empty gitlink in OnePlus OOS kernel">
      <source origin="oplus-clone" path="kernel/msm-4.19/techpack/video"/>
      <source origin="luk"         path="techpack/video"/>
    </entry>

    <!-- ===================== WLAN: CLD host driver (wlan.ko) ===================== -->
    <!-- drivers/staging/qcacld-3.0/Kbuild takes its KERNEL_BUILD branch (MODNAME empty),
         sets MODNAME=wlan and pulls its sources from ../qca-wifi-host-cmn and ../fw-api,
         i.e. it expects exactly the sibling layout created by these four symlinks. -->
    <entry name="fw-api" dst="drivers/staging/fw-api" mode="symlink" enabled="true"
           config="compiled into CONFIG_QCA_CLD_WLAN (wlan.ko)">
      <source origin="oplus" path="qcom/opensource/wlan/fw-api"/>
      <source origin="luk"   path="drivers/staging/fw-api"/>
    </entry>

    <entry name="qca-wifi-host-cmn" dst="drivers/staging/qca-wifi-host-cmn" mode="symlink" enabled="true"
           config="compiled into CONFIG_QCA_CLD_WLAN (wlan.ko)">
      <source origin="oplus" path="qcom/opensource/wlan/qca-wifi-host-cmn"/>
      <source origin="luk"   path="drivers/staging/qca-wifi-host-cmn"/>
    </entry>

    <entry name="qcacld-3.0" dst="drivers/staging/qcacld-3.0" mode="symlink" enabled="true"
           config="CONFIG_QCA_CLD_WLAN=m, set by Patches/Patch/defconfig_oos.patch">
      <source origin="oplus" path="qcom/opensource/wlan/qcacld-3.0"/>
      <source origin="luk"   path="drivers/staging/qcacld-3.0"/>
      <!-- kbuild enters the driver only if drivers/staging/{Makefile,Kconfig} name it;
           the Kconfig entry has to stay inside the `if STAGING` block. -->
      <glue file="drivers/staging/Makefile" line="obj-$(CONFIG_QCA_CLD_WLAN)\t+= qcacld-3.0/"/>
      <glue file="drivers/staging/Kconfig" before="endif # STAGING"
            line="source &quot;drivers/staging/qcacld-3.0/Kconfig&quot;"/>
    </entry>

    <entry name="wlan-utils" dst="drivers/staging/utils" mode="symlink" enabled="true"
           config="none (sigma-dut only, Android.mk based; not part of the kbuild output)"
           note="no luk counterpart - LineageOS never vendored it, nothing references ../utils">
      <source origin="oplus" path="qcom/opensource/wlan/utils"/>
    </entry>

    <!-- ===================== audio-kernel -> techpack/audio ===================== -->
    <!-- vendor audio-kernel/Makefile is the in-tree one: for CONFIG_ARCH_KONA it includes
         techpack/audio/config/konaauto.conf and ends with unconditional obj-y += soc/ dsp/
         ipc/ asoc/, so copying it in builds the audio codecs INTO the kernel - while the OOS
         ROM loads its own audio DLKMs at boot. Declared, not enabled, so a CI run keeps the
         current output; flip enabled to true only together with a decision about those DLKMs. -->
    <entry name="audio-kernel" dst="techpack/audio" mode="copy" enabled="false"
           config="obj-y (in-kernel), gated by CONFIG_ARCH_KONA in techpack/audio/Makefile"
           note="declared only; enabling would collide with the audio DLKMs OxygenOS loads">
      <source origin="oplus" path="qcom/opensource/audio-kernel"/>
      <source origin="luk"   path="techpack/audio"/>
    </entry>

    <!-- ===================== data-kernel -> techpack/data ===================== -->
    <!-- vendor data-kernel ships no top-level Makefile/Kconfig (OnePlus builds it from
         Android.mk), so the kbuild glue lives in this repository and is overlaid below.
         Its drivers/rmnet/{perf,shs}/Kbuild use `obj-m`, i.e. enabling this entry adds
         rmnet_perf.ko + rmnet_shs.ko to the module set. Declared, not enabled, for the
         same reason as audio-kernel. -->
    <entry name="data-kernel" dst="techpack/data" mode="copy" enabled="false"
           config="RMNET_PERF / RMNET_SHS (obj-m in the vendor Kbuild files)"
           note="declared only; enabling would add rmnet modules the OOS ROM ships as DLKMs">
      <source origin="oplus" path="qcom/opensource/data-kernel"/>
      <source origin="luk"   path="techpack/data"/>
      <overlay dir="Drivers/techpack/data" dst="techpack/data"/>
    </entry>

  </map>

  <!-- Paths the OOS kernel tree needs to resolve for the build to work at all. They are
       relative symlinks into vendor/ (e.g. arch/arm64/boot/dts/vendor -> ../../dts/vendor),
       which is why vendor/ has to stay six levels above arch/arm64/boot/dts. -->
  <require>
    <path value="kernel/msm-4.19/arch/arm64/boot/dts/vendor"/>
    <path value="kernel/msm-4.19/drivers/soc/oplus/system"/>
    <path value="kernel/msm-4.19/drivers/power/oplus"/>
    <path value="kernel/msm-4.19/drivers/input/touchscreen/oplus_touchscreen"/>
    <path value="kernel/msm-4.19/fs/erofs"/>
  </require>

</drivers-manifest>